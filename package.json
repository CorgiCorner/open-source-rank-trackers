{
  "name": "open-source-rank-trackers",
  "version": "0.0.0",
  "private": true,
  "description": "A maintained comparison of open-source, self-hosted SEO rank trackers - features, licenses, data sources, and project health.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.23.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.9.3",
      "onFail": "error"
    }
  },
  "scripts": {
    "candidates:discover": "tsx scripts/discover-candidates.ts",
    "candidates:queue": "tsx scripts/candidate-queue.ts",
    "candidates:stats": "tsx scripts/candidate-stats.ts",
    "check": "npm run check:node && npm run typecheck && npm run validate && npm run check:generated && npm test",
    "check:generated": "tsx scripts/generate-readme.ts --check",
    "check:node": "tsx scripts/check-node.ts",
    "generate": "tsx scripts/generate-readme.ts",
    "metrics:check-links": "tsx scripts/check-links.ts",
    "metrics:refresh": "tsx scripts/refresh-metrics.ts",
    "outreach": "tsx scripts/render-outreach.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "spdx-license-list": "6.12.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
